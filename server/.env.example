# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set your local MongoDB or MongoDB Atlas URI:
# e.g., mongodb+srv://<username>:<password>@cluster.mongodb.net/toystore
MONGO_URI=mongodb://127.0.0.1:27017/toystore

# JWT Secret Key
JWT_SECRET=toystore_super_secret_jwt_key_2026

# Razorpay Test Credentials (Optional for local test mode)
RAZORPAY_KEY_ID=rzp_test_toyShopDemoKey123
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

